# === Основні налаштування сервера ===
PORT=3001
NODE_ENV=development

# === Ключ шифрування AES-256-GCM (для нотаток і ключів Spotify у БД) ===
# Згенеруйте випадковий 64-символьний hex-ключ командою:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=change-this-to-a-64-char-random-hex-key-in-production

# === Віддалена база даних Turso (безкоштовний хмарний SQLite) ===
# Якщо залишити порожніми, локально використовуватиметься файл data/tracker.sqlite
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# === Опціональний глобальний Spotify Web API (можна також задати в Налаштуваннях у UI) ===
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
