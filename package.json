{
  "name": "universal-discography-rating-tracker",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Universal Multi-Artist Discography & Rating Tracker (SQLite + Spotify Embeds + Hybrid Auto-Import)",
  "scripts": {
    "dev": "node ./node_modules/concurrently/dist/bin/concurrently.js -k -n SERVER,CLIENT -c yellow,cyan \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node ./node_modules/tsx/dist/cli.mjs watch --exclude data --exclude dist server/index.ts",
    "dev:client": "node ./node_modules/vite/bin/vite.js",
    "build": "node ./node_modules/typescript/bin/tsc -b && node ./node_modules/vite/bin/vite.js build",
    "start": "node ./node_modules/tsx/dist/cli.mjs server/index.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^18.0.10",
    "express": "^5.1.0",
    "helmet": "^8.3.0",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "tsx": "^4.19.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.7",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.2",
    "@types/node": "^22.15.18",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
